    {
      "name": "异常场景",
      "description": "参数校验与不存在资源的异常响应",
      "item": [
        {
          "name": "分配角色-用户不存在",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('返回404', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(404);",
                  "    pm.expect(json.message).to.include('用户不存在');",
                  "});"
                ]
              }
            }
          ],
